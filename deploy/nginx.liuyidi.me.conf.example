# Aliyun ECS nginx: apex landing + bot. Do NOT add kb.liuyidi.me here.
#
# mlf.liuyidi.me lives on Tencent Cloud — do NOT proxy it here.
# kb.liuyidi.me lives on Volcengine (TLS on that host) — do NOT proxy it here.
# auth.liuyidi.me may already have a separate Certbot-managed server block on
# this host; leave that alone when installing this template.
#
# Layout on ECS:
#   /opt/demo/minibot/site/.vitepress/dist  → https://liuyidi.me
#   minibot container                       → 127.0.0.1:8766
#
# Install (after Certbot already issued certs for liuyidi.me / www / bot):
#   1. Merge ssl_certificate lines from the live site into each 443 server
#   2. sudo nginx -t && sudo systemctl reload nginx
#
# Cert name on this host is historically still under
#   /etc/letsencrypt/live/mlf.liuyidi.me/
# SAN list is liuyidi.me / www / bot (no kb, no mlf).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream demo_bot { server 127.0.0.1:8766; keepalive 16; }

# ---------- Landing: liuyidi.me ----------
server {
    listen 80;
    listen [::]:80;
    server_name liuyidi.me www.liuyidi.me;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name liuyidi.me www.liuyidi.me;

    # ssl_certificate     /etc/letsencrypt/live/mlf.liuyidi.me/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mlf.liuyidi.me/privkey.pem;

    root /opt/demo/minibot/site/.vitepress/dist;
    index index.html;
    error_page 404 /404.html;

    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }
}

# ---------- minibot ----------
server {
    listen 80;
    listen [::]:80;
    server_name bot.liuyidi.me;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bot.liuyidi.me;

    # ssl_certificate     /etc/letsencrypt/live/mlf.liuyidi.me/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mlf.liuyidi.me/privkey.pem;

    client_max_body_size 16m;

    location / {
        proxy_pass http://demo_bot;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}
