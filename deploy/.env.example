# Copy to /opt/minibot/.env on the server.
# Keep secrets out of git.

# Runtime binding
MINIBOT_SERVER_HOST=0.0.0.0
MINIBOT_SERVER_PORT=8766
MINIBOT_SERVER_DATA_DIR=/data

# Shared auth service
MINIBOT_SERVER_AUTH_PROVIDER=mini_auth
MINIBOT_SERVER_MINI_AUTH_BASE_URL=https://auth.liuyidi.me
MINIBOT_SERVER_MINI_AUTH_CLIENT_ID=minibot
MINIBOT_SERVER_MINI_AUTH_SCOPE=openid profile email
MINIBOT_SERVER_MINI_AUTH_CALLBACK_PATH=/auth/mini-auth/callback
MINIBOT_SERVER_MINI_AUTH_TIMEOUT_S=20.0
MINIBOT_SERVER_REQUIRE_AUTH=true

# Models / providers
MINIBOT_SERVER_OPENAI_API_KEY=<put-openai-or-compatible-key-here>
MINIBOT_SERVER_OPENAI_BASE_URL=https://api.openai.com/v1
MINIBOT_SERVER_MODEL=gpt-4o-mini

# Optional observability / integrations
MINIBOT_SERVER_LANGFUSE_ENABLED=false
MINIBOT_SERVER_MINIKB_BASE_URL=
MINIBOT_SERVER_EXEC_BACKEND=local
