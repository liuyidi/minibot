# Copy to deploy/.env on the ECS host (next to docker-compose.yml).
#   cp .env.example .env
# Do not commit .env.

# Build-time: path to mini-langfuse/sdk-python (sibling clone on ECS).
LANGFUSE_SDK_DIR=/opt/demo/mini-langfuse/sdk-python
VITE_MINIBOT_RELEASES_URL=https://downloads.liuyidi.me/minibot/releases.json

# Existing Aliyun volume from the old demo compose (keep sessions).
MINIBOT_DATA_VOLUME=agent-demo_demo_minibot

# --- Auth (shared mini-auth) ---
MINIBOT_SERVER_AUTH_PROVIDER=mini_auth
MINIBOT_SERVER_REQUIRE_AUTH=true
MINIBOT_SERVER_MINI_AUTH_BASE_URL=https://auth.liuyidi.me
MINIBOT_SERVER_MINI_AUTH_CLIENT_ID=minibot
MINIBOT_SERVER_MINI_AUTH_SCOPE=openid profile email
MINIBOT_SERVER_MINI_AUTH_CALLBACK_PATH=/auth/mini-auth/callback
MINIBOT_SERVER_MINI_AUTH_TIMEOUT_S=20.0

# --- Default model slot (DeepSeek / OpenAI-compatible) ---
MINIBOT_SERVER_OPENAI_API_KEY=
MINIBOT_SERVER_OPENAI_BASE_URL=https://api.deepseek.com/v1
MINIBOT_SERVER_OPENAI_MODEL=deepseek-v4-flash
MINIBOT_SERVER_MODEL=deepseek-v4-flash

# Optional platform slots (paste from .env.models / merge-env.sh)
# MINIBOT_SERVER_DEEPSEEK_PRO_API_KEY=
# MINIBOT_SERVER_QWEN_API_KEY=
# MINIBOT_SERVER_GLM_API_KEY=
# MINIBOT_SERVER_KIMI_API_KEY=
# MINIBOT_SERVER_MINIMAX_API_KEY=
# MINIBOT_SERVER_DOUBAO_API_KEY=
# MINIBOT_SERVER_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# MINIBOT_SERVER_DOUBAO_MODEL=doubao-seed-2.0-lite

# --- Observability (Tencent mini-langfuse) ---
MINIBOT_SERVER_LANGFUSE_ENABLED=true
MINIBOT_SERVER_LANGFUSE_HOST=https://mlf.liuyidi.me
MINIBOT_SERVER_LANGFUSE_PUBLIC_KEY=pk-lf-demo
MINIBOT_SERVER_LANGFUSE_SECRET_KEY=sk-lf-demo

# --- minikb (public URL; Aliyun nginx → Volcengine) ---
MINIBOT_SERVER_MINIKB_BASE_URL=https://kb.liuyidi.me
# MINIBOT_SERVER_MINIKB_API_KEY=
MINIBOT_SERVER_MINIKB_UI_URL=https://kb.liuyidi.me/ui/

# --- Budgets (UTC). 0 = unlimited for that dimension ---
MINIBOT_SERVER_DAILY_TURN_LIMIT=200
MINIBOT_SERVER_DAILY_TOKEN_LIMIT=2000000
MINIBOT_SERVER_DESKTOP_DAILY_TURN_LIMIT=100
MINIBOT_SERVER_DESKTOP_DAILY_TOKEN_LIMIT=1000000

# --- exec sandbox ---
MINIBOT_SERVER_EXEC_BACKEND=local
# MINIBOT_SERVER_E2B_API_KEY=
