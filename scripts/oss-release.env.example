# Copy this file to scripts/oss-release.env, fill the non-secret values, then:
# source scripts/oss-release.env
# export OSS_ACCESS_KEY_ID=...
# export OSS_ACCESS_KEY_SECRET=...

export OSS_BUCKET="your-download-bucket"
export OSS_REGION="cn-hangzhou"
export OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
export OSS_PUBLIC_BASE_URL="https://downloads.example.com"
export OSS_PREFIX="minibot"

# Public installers need anonymous read access, either directly from OSS or via
# CDN. Set this to default when the bucket policy/CDN origin handles it.
export OSS_OBJECT_ACL="public-read"
