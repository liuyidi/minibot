# Copy to desktop/scripts/signing/apple-signing.env, fill values, then:
#   ./scripts/signing/build-signed-macos.sh
#
# Do not commit apple-signing.env or .p12 files.
#
# Local macOS: certificate + private key in Keychain is enough for signing;
# you usually only need the four notarization exports below. CI runners have
# no Keychain — set APPLE_CERTIFICATE (base64 .p12) and APPLE_CERTIFICATE_PASSWORD
# in GitHub Actions secrets with the same names.

export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
export APPLE_TEAM_ID="ABCDE12345"
export APPLE_ID="you@example.com"
# App-specific password from appleid.apple.com (format xxxx-xxxx-xxxx-xxxx)
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# CI only (optional locally if Keychain already has the cert):
# export APPLE_CERTIFICATE="$(base64 -i /path/to/cert.p12 | tr -d '\n')"
# Password you chose when exporting the .p12 (NOT Apple ID login password)
# export APPLE_CERTIFICATE_PASSWORD="your-p12-export-password"
