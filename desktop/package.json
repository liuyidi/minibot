{
  "name": "nanobot-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri engine host for nanobot WebUI",
  "type": "module",
  "scripts": {
    "dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "dev:renderer": "vite",
    "build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --bundles app,dmg",
    "build:app": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --bundles app",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
