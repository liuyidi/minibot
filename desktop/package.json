{
  "name": "minibot-desktop",
  "private": true,
  "version": "1.0.18",
  "description": "Tauri desktop — local minibot gateway shell",
  "type": "module",
  "scripts": {
    "dev": "./scripts/tauri/run-tauri.sh dev",
    "dev:renderer": "vite",
    "build": "./scripts/tauri/run-tauri.sh build --bundles app,dmg",
    "build:app": "./scripts/tauri/run-tauri.sh build --bundles app",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
