# Platform model slots (secrets). Copy to .env.models and fill keys.
# Merge with .env.runtime → .env via:  ./scripts/merge-env.sh
# Do NOT commit .env.models.
#
# Convention per slot:
#   MINIBOT_SERVER_{SLOT}_API_KEY=
#   MINIBOT_SERVER_{SLOT}_BASE_URL=
#   MINIBOT_SERVER_{SLOT}_MODEL=
#
# Slots: openai | deepseek_pro | qwen | glm | kimi | minimax | doubao
# openai / deepseek_pro / qwen / glm / kimi / minimax → OpenAI-compat
# doubao → Anthropic Messages-compatible

# DeepSeek Flash (legacy openai slot)
# MINIBOT_SERVER_OPENAI_API_KEY=
# MINIBOT_SERVER_OPENAI_BASE_URL=https://api.deepseek.com/v1
# MINIBOT_SERVER_OPENAI_MODEL=deepseek-v4-flash
# MINIBOT_SERVER_MODEL=deepseek-v4-flash

# DeepSeek Pro
# MINIBOT_SERVER_DEEPSEEK_PRO_API_KEY=
# MINIBOT_SERVER_DEEPSEEK_PRO_BASE_URL=https://api.deepseek.com/v1
# MINIBOT_SERVER_DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Qwen (OpenAI-compat)
# MINIBOT_SERVER_QWEN_API_KEY=
# MINIBOT_SERVER_QWEN_BASE_URL=
# MINIBOT_SERVER_QWEN_MODEL=qwen3.7-plus

# GLM (OpenAI-compat)
# MINIBOT_SERVER_GLM_API_KEY=
# MINIBOT_SERVER_GLM_BASE_URL=
# MINIBOT_SERVER_GLM_MODEL=glm-5.2

# Kimi (OpenAI-compat)
# MINIBOT_SERVER_KIMI_API_KEY=
# MINIBOT_SERVER_KIMI_BASE_URL=
# MINIBOT_SERVER_KIMI_MODEL=kimi-k2.7-code

# MiniMax (OpenAI-compat)
# MINIBOT_SERVER_MINIMAX_API_KEY=
# MINIBOT_SERVER_MINIMAX_BASE_URL=
# MINIBOT_SERVER_MINIMAX_MODEL=minimax-m3

# Doubao (Anthropic-compatible Messages API)
# MINIBOT_SERVER_DOUBAO_API_KEY=
# MINIBOT_SERVER_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# MINIBOT_SERVER_DOUBAO_MODEL=doubao-seed-2.0-lite
