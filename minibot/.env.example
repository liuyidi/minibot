# Copy to .env and adjust. Prefix: MINIBOT_SERVER_

# MINIBOT_SERVER_OPENAI_API_KEY=
# MINIBOT_SERVER_OPENAI_BASE_URL=https://api.openai.com/v1
# MINIBOT_SERVER_MODEL=gpt-4o-mini

# mini-langfuse (requires: pip install -e <repo>/mini-langfuse/sdk-python)
# MINIBOT_SERVER_LANGFUSE_ENABLED=true
# MINIBOT_SERVER_LANGFUSE_HOST=http://localhost:8000  # or :8005 if API was started on another port
# MINIBOT_SERVER_LANGFUSE_PUBLIC_KEY=pk-lf-demo
# MINIBOT_SERVER_LANGFUSE_SECRET_KEY=sk-lf-demo
