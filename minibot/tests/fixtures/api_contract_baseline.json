  "responses": {
    "GET /health": {
      "required_keys": [
        "runtime",
        "status"
      ]
    },
    "GET /auth/bootstrap": {
      "required_keys": [
        "expires_in",
        "model_name",
        "runtime_surface",
        "token",
        "ws_path"
      ]
    },
    "GET /api/sessions": {
      "required_keys": [
        "sessions"
      ],
      "nested": {
        "sessions": {
          "item_required_keys": [
            "created_at",
            "id",
            "key",
            "preview",
            "title",
            "updated_at",
            "workspace_path",
            "workspace_scope"
          ],
          "nested": {
            "workspace_scope": {
              "required_keys": [
                "access_mode",
                "project_name",
                "project_path",
                "restrict_to_workspace"
              ]
            }
          }
        }
      }
    },
    "GET /api/settings": {
      "required_keys": [
        "active_platform_model",
        "active_preset",
        "advanced",
        "agent",
        "channels",
        "image_generation",
        "mcp_presets",
        "model_presets",
