        "platform_models",
        "provider_detail",
        "providers",
        "requires_restart",
        "runtime",
        "runtime_capabilities",
        "runtime_surface",
        "surface",
        "transcription",
        "usage",
        "version",
        "web",
        "web_search"
      ]
    },
    "GET /status.json": {
      "required_keys": [
        "components",
        "generated_at",
        "incidents",
        "links",
        "optional_disabled",
        "overall",
        "runtime"
      ]
    },
    "GET /auth/config": {
