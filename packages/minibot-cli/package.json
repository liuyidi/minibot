  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@liuyidi/minibot-client": "1.0.17",
    "cac": "^6.7.14",
    "chalk": "^5.6.2",
    "open": "^10.2.0",
    "ora": "^8.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
