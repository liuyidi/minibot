{
  "name": "@liuyidi/minibot",
  "version": "1.0.20",
  "description": "CLI for minibot auth, chat, status, and sessions",
  "type": "module",
  "bin": {
    "minibot": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuyidi/minibot.git",
    "directory": "packages/minibot-cli"
  },
