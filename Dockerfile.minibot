# Build context: monorepo root (contains minibot/).
# WebUI is NOT baked into this image — Publish WebUI (ECS) promotes
# deploy/webui-dist on the host and docker-compose bind-mounts it.
# additional_contexts:
#   langfuse_sdk: path to mini-langfuse/sdk-python

FROM docker.m.daocloud.io/library/python:3.11-slim

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
      sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list; \
      sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY minibot/pyproject.toml minibot/README.md ./
COPY minibot/src ./src

COPY --from=langfuse_sdk . /tmp/sdk-python

# Install the vendored sdk first, then strip the git+https pin so pip never
# clones GitHub from inside the ECS builder (often blocked / flaky).
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com --upgrade pip \
    && pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com /tmp/sdk-python \
    && python -c "from pathlib import Path; p=Path('pyproject.toml'); t=p.read_text(); n='    \"mini-langfuse-sdk @ git+https://github.com/liuyidi/mini-langfuse.git@main#subdirectory=sdk-python\",\\n'; assert n in t, 'mini-langfuse-sdk git pin not found'; p.write_text(t.replace(n, ''))" \
    && pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com '.[e2b,feishu]' \
    && rm -rf /tmp/sdk-python /root/.cache/pip

# Placeholder so the path exists if the host volume is empty at first start.
RUN mkdir -p /app/webui-dist

ENV MINIBOT_SERVER_HOST=0.0.0.0 \
    MINIBOT_SERVER_PORT=8766 \
    MINIBOT_SERVER_DATA_DIR=/data \
    MINIBOT_WEBUI_DIST=/app/webui-dist

VOLUME ["/data"]
EXPOSE 8766

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD curl -fsS http://localhost:8766/health || exit 1

CMD ["minibot"]
